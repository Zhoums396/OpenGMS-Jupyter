{
  "openapi": "3.1.0",
  "info": {
    "title": "GeoCopilot Jupyter Server API",
    "version": "1.0.0a1"
  },
  "paths": {
    "/geocopilot/api/status": {
      "get": { "responses": { "200": { "description": "Agent status" } } }
    },
    "/geocopilot/api/settings": {
      "get": { "responses": { "200": { "description": "Write-only credential projection" } } },
      "put": {
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "apiKey": { "type": "string", "writeOnly": true },
                  "baseUrl": { "type": "string" },
                  "model": { "type": "string" },
                  "clearApiKey": { "type": "boolean" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Updated settings" },
          "409": { "description": "turn_active" }
        }
      }
    },
    "/geocopilot/api/conversation": {
      "get": { "responses": { "200": { "description": "Conversation projection" } } }
    },
    "/geocopilot/api/turn": {
      "post": {
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/TurnRequest" }
            }
          }
        },
        "responses": {
          "202": { "description": "Turn accepted" },
          "409": { "description": "turn_active" }
        }
      }
    },
    "/geocopilot/api/turn/{turnId}/cancel": {
      "post": {
        "parameters": [
          { "name": "turnId", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": { "202": { "description": "Interrupt requested" } }
      }
    },
    "/geocopilot/api/conversation/reset": {
      "post": {
        "responses": {
          "200": { "description": "Conversation reset" },
          "409": { "description": "turn_active" }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "TurnRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["message", "clientMessageId", "context"],
        "properties": {
          "message": { "type": "string", "minLength": 1 },
          "clientMessageId": { "type": "string", "minLength": 1 },
          "context": {
            "type": "object",
            "properties": {
              "activeNotebookPath": { "type": "string" },
              "activeCellId": { "type": "string" },
              "selectedCellIds": { "type": "array", "items": { "type": "string" } },
              "selectedText": { "type": "string" },
              "activeCellSourceHash": { "type": "string" },
              "kernelSessionId": { "type": "string" }
            }
          }
        }
      }
    }
  }
}
