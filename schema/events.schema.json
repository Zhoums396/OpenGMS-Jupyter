{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opengeolab.org/geocopilot/schemas/events.schema.json",
  "title": "GeoCopilot event",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "sequence",
    "timestamp",
    "type",
    "threadId",
    "turnId",
    "itemId",
    "payload"
  ],
  "properties": {
    "sequence": { "type": "integer", "minimum": 1 },
    "timestamp": { "type": "number" },
    "type": { "type": "string", "minLength": 1 },
    "threadId": { "type": "string" },
    "turnId": { "type": "string" },
    "itemId": { "type": "string" },
    "payload": { "type": "object" }
  }
}
