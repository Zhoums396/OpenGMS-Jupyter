{
  "name": "@opengeolab/geocopilot",
  "version": "0.4.14",
  "description": "A Codex-powered, notebook-native general agent for JupyterLab",
  "license": "MIT",
  "author": {
    "name": "OpenGMS Team"
  },
  "files": [
    "lib/**/*.{js,js.map,d.ts}",
    "style/**/*.{css,js}"
  ],
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "style": "style/index.css",
  "sideEffects": [
    "style/*.css",
    "style/index.js"
  ],
  "scripts": {
    "build": "npm run build:lib && npm run build:labextension:dev",
    "build:lib": "tsc --sourceMap",
    "build:lib:prod": "tsc",
    "build:labextension": "jupyter labextension build .",
    "build:labextension:dev": "jupyter labextension build --development True .",
    "build:prod": "npm run clean && npm run build:lib:prod && npm run build:labextension",
    "clean": "rimraf lib geocopilot/labextension tsconfig.tsbuildinfo",
    "install:extension": "npm run build",
    "lint": "tsc --noEmit",
    "test:ui": "playwright test",
    "watch": "run-p watch:src watch:labextension",
    "watch:src": "tsc -w --sourceMap",
    "watch:labextension": "jupyter labextension watch ."
  },
  "dependencies": {
    "@jupyterlab/application": "^4.4.0",
    "@jupyterlab/apputils": "^4.4.0",
    "@jupyterlab/coreutils": "^6.4.0",
    "@jupyterlab/notebook": "^4.4.0",
    "@jupyterlab/rendermime": "^4.4.0",
    "@jupyterlab/services": "^7.4.0",
    "@jupyterlab/ui-components": "^4.4.0",
    "@lumino/widgets": "^2.5.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@jupyterlab/builder": "^4.4.0",
    "@playwright/test": "^1.62.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "npm-run-all": "^4.1.5",
    "rimraf": "^6.0.0",
    "typescript": "~5.6.3"
  },
  "jupyterlab": {
    "extension": true,
    "outputDir": "geocopilot/labextension"
  }
}
